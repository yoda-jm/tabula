# Settings for the concert-video skill (.claude/skills/concert-video), for
# this computer. Copy to .env (kept out of git) and fill in what differs;
# the environment wins over this file.

# Where tabula keeps the recorded sessions (default: sessions/ here).
#TABULA_SESSIONS=/path/to/sessions

# The tabula and tabula-emu binaries (default: bin/ here, `make build`).
#TABULA_BIN=/path/to/bin

# The folder holding one folder per concert video (YYYYMMDD_name/).
#CONCERT_VIDEOS=/path/to/videos

# A Python with openai-whisper, torch, soundfile, scipy and matplotlib
# (transcription, timelines, spectrograms). Default: python3.
#WHISPER_PYTHON=/path/to/venv/bin/python

# A troubastack server to read the setlists from (the login is asked for
# each time, never kept here).
#TROUBASTACK_URL=http://localhost:8080
