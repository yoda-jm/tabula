{
  "name": "tabula-web",
  "version": "0.0.0",
  "private": true,
  "description": "tabula web GUI. Built into web/dist, which the tabula binary embeds.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"require('fs').writeFileSync('dist/.gitkeep','')\"",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest"
  },
  "dependencies": {
    "qrcode-generator": "1.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.5.4",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
